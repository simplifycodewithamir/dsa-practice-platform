<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <UserSecretsId>b016cfe2-2a62-4213-a3bb-f012f0d9bb83</UserSecretsId>
    <!-- Runnable: applies migrations and seeds content in one shot (see Program.cs). Still the
         migrations assembly, so `dotnet ef migrations add` targets this project as before. -->
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\DsaPractice.DataAccess\DsaPractice.DataAccess.csproj" />
    <ProjectReference Include="..\..\DsaPractice.ContentSeeding\DsaPractice.ContentSeeding.csproj" />
  </ItemGroup>

</Project>
