<Project>
  <!--
    Package versions are centralized at the repo root in Directory.Packages.props
    (NuGet Central Package Management), not here. This file only auto-adds
    packages every source/ project should get without asking for them.
  -->
  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning" PrivateAssets="all" />
  </ItemGroup>
</Project>