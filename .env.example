POSTGRES_DB=dsapractice
POSTGRES_USER=dsapractice
POSTGRES_PASSWORD=change-me

RABBITMQ_USER=dsapractice
RABBITMQ_PASSWORD=change-me

# Bearer tokens for the containerised Api, for when there is no identity provider to get one from
# (the end-to-end stack, and a checkout with no tenant of its own). Regenerate the key and mint a
# matching token with: node tools/mint-dev-token.mjs
#
# Not a secret. It is only ever trusted by an Api you run yourself, and the Api refuses to start
# with a symmetric signing key in Production. A real deployment sets Authority instead -- docs/auth.md.
DEV_JWT_ISSUER=dsa-practice-dev
DEV_JWT_AUDIENCE=dsa-practice-api
DEV_JWT_SIGNING_KEY=0D9Govz9WsiZ/seTxv6hDLnhJwp4/bFDcPTJRW7Xnco=
