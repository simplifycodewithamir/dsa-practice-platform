{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-api",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/source/DsaPractice.Api/DsaPractice.Api.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-migrator",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/source/DataMigrations/DsaPractice.DataMigrations.Postgres/DsaPractice.DataMigrations.Postgres.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    },
    {
      "label": "build-judge",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/source/DsaPractice.Judge/DsaPractice.Judge.csproj",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}
