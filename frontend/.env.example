# Copy to .env.local (gitignored) to point the app at an identity provider.
# Everything here is baked into the bundle and readable by anyone who opens the page -- which is
# fine: a public OIDC client has no secret to keep. See ../docs/auth.md for where to get these.

# Unset both of these and the app runs signed-out: questions are readable, submitting is not
# offered. That is the default for a fresh checkout with no tenant of its own.
VITE_OIDC_AUTHORITY=https://<your-tenant>.<region>.auth0.com/
VITE_OIDC_CLIENT_ID=<the SPA application's client id>

# The Api's identifier at the provider. Without it Auth0 issues a token for its own userinfo
# endpoint instead of one this Api will accept.
VITE_OIDC_AUDIENCE=https://api.dsapractice.local

# Only used when no authority is configured -- see tools/mint-dev-token.mjs and the end-to-end
# stack. A build with a real authority ignores it.
# VITE_DEV_ACCESS_TOKEN=
